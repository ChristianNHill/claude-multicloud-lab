# ── mock cloud (default) — run every lab offline, no cloud account needed ──
# Start it with:  python mock_cloud/server.py
# Don't add your own keys. The credentials below have to be present for the
# SDKs to build a client, but they are never checked — any string works.
# Comment this whole block out to go back to real platforms and fill in the
# section below it; no lab code changes either way. See mock_cloud/README.md.
ANTHROPIC_BASE_URL=http://127.0.0.1:8787/direct
ANTHROPIC_BEDROCK_BASE_URL=http://127.0.0.1:8787/bedrock
ANTHROPIC_VERTEX_BASE_URL=http://127.0.0.1:8787/vertex/v1
AZURE_FOUNDRY_ENDPOINT=http://127.0.0.1:8787/foundry
ANTHROPIC_API_KEY=mock
AWS_ACCESS_KEY_ID=mock
AWS_SECRET_ACCESS_KEY=mock
VERTEX_PROJECT_ID=mock-project
AZURE_FOUNDRY_API_KEY=mock
# AnthropicVertex calls google.auth.default() unless this is set, which fails
# without real ADC. Leave it out when using real Vertex.
VERTEX_ACCESS_TOKEN=mock

# ── real platforms — only needed once you comment out the block above ──

# Direct Anthropic API (get a key at console.anthropic.com)
# ANTHROPIC_API_KEY=your-api-key-here

# AWS Bedrock
# Credentials are picked up from your AWS profile by default.
# Set the keys only if you need to override the profile.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Google Vertex AI
# Auth uses Application Default Credentials: gcloud auth application-default login
# VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_REGION=us-east5

# Azure AI Foundry
# Endpoint looks like: https://<resource>.services.ai.azure.com/models
# AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/models
# AZURE_FOUNDRY_API_KEY=your-api-key-here
# Model name as deployed in your Foundry project
AZURE_FOUNDRY_MODEL=claude-sonnet-4-6
