# Direct Anthropic API (fastest way to get started — get a key at console.anthropic.com)
ANTHROPIC_API_KEY=your-api-key-here

# AWS Bedrock
# Credentials are picked up from your AWS profile by default.
# Set these only if you need to override the profile or use explicit keys.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Google Vertex AI
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_REGION=us-east5

# Google Vertex AI — leave unset to use Application Default Credentials.
# Set to any string only when pointing at the mock server (see mock_cloud/).
# VERTEX_ACCESS_TOKEN=

# Azure AI Foundry
# Endpoint looks like: https://<resource>.services.ai.azure.com/models
AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/models
AZURE_FOUNDRY_API_KEY=your-api-key-here
# Model name as deployed in your Foundry project
AZURE_FOUNDRY_MODEL=claude-3-5-sonnet

# ── mock cloud — run every lab offline, no cloud account needed ──
# Start it with:  python mock_cloud/server.py
# Then uncomment the four base URLs below and set the credentials above to
# any string ("mock" works). Comment them out again to go back to real
# platforms — no lab code changes either way. See mock_cloud/README.md.
# ANTHROPIC_BASE_URL=http://127.0.0.1:8787/direct
# ANTHROPIC_BEDROCK_BASE_URL=http://127.0.0.1:8787/bedrock
# ANTHROPIC_VERTEX_BASE_URL=http://127.0.0.1:8787/vertex/v1
# AZURE_FOUNDRY_ENDPOINT=http://127.0.0.1:8787/foundry
